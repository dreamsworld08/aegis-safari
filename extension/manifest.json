{
  "manifest_version": 3,
  "name": "Aegis — AI Sidebar Agent",
  "short_name": "Aegis",
  "version": "0.1.0",
  "description": "Bring-your-own-model AI sidebar and browsing agent for Safari. Reads, controls and manages tabs with explicit approval.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Toggle Aegis sidebar", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "scripts": ["background.js"], "persistent": false },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["tabs", "storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["sidebar.html", "sidebar.js", "sidebar.css"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Alt+A", "mac": "Command+Shift+K" },
      "description": "Toggle the Aegis sidebar"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
